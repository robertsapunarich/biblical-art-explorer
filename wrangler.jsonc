// wrangler.jsonc
{
    "name": "biblical-art-explorer",
    "main": "src/index.ts",
    "compatibility_date": "2025-02-11",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1
    },

    // AI for processing
    "ai": {
      "binding": "AI"
    },

    // Browser Rendering API
    "browser":{
      "binding": "BROWSER"
    },

    // Static assets for frontend
    "assets": {
      "directory": "./public",
      "binding": "ASSETS"
    }
  }
